# Application
APP_ENV=development
# IANA timezone used to calculate the per-run local date shown to the agent.
APP_TIMEZONE=America/Bahia
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Host interface used only for the Docker-published application port. Keep it
# on loopback when a reverse proxy runs on the same host.
APP_BIND_ADDRESS=127.0.0.1
# Public hostname served by the reverse proxy. Read only by
# docker-compose.prod.yml to build the Traefik routing rules on the VPS.
PUBLIC_HOST=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# cos-mariana simulator integration. Generate one shared secret and configure
# the same value as RADAR_API_KEY in both applications. Empty keeps these
# authenticated endpoints disabled.
RADAR_API_KEY=
# Voice messages. A recording longer or heavier than this is refused before
# any download, with an explanation sent back to the chat.
TELEGRAM_AUDIO_MAX_BYTES=10485760
TELEGRAM_AUDIO_MAX_DURATION_SECONDS=120
# Files sent in the chat: PDF, image, text, .docx, .xlsx and .pptx. They are
# stored in the conversation's workspace under /anexos/ and stay readable on
# later messages. A heavier file is refused before any download, with an
# explanation sent back to the chat. Telegram itself will not serve a file
# above 20 MB, so raising this past that has no effect.
TELEGRAM_ATTACHMENTS_ENABLED=true
TELEGRAM_DOCUMENT_MAX_BYTES=5242880
# Rich Messages (Bot API 10.1): headings, real lists, tables, collapsible
# sections and a draft streamed while the agent runs. Set to false to reply
# with plain sendMessage + parse_mode, which stays the fallback either way.
TELEGRAM_RICH_MESSAGES_ENABLED=true

# Speech-to-text
# Voice messages are transcribed through any endpoint implementing the
# OpenAI-compatible /audio/transcriptions contract. Leave STT_API_KEY empty to
# reuse OPENAI_API_KEY, or empty on both to answer voice notes with a message
# saying audio is unavailable — the text flow is unaffected either way.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=pt
STT_TIMEOUT_SECONDS=30
STT_MAX_BYTES=26214400

# Independent safety caps for one agent execution.
AGENT_TOOL_CALL_BUDGET=16
AGENT_IDENTICAL_TOOL_CALL_BUDGET=2

# RADAR
# Optional and off by default. The vault is live data mounted at the
# configured path; Core, rules and policies come from the pinned radar-vault
# package and never from this repository's legacy ontology/ copy.
RADAR_ENABLED=false
RADAR_BACKEND=vault
# Use command-layer for PostgreSQL RADAR; bind identities and issue a host token first.
# The URL includes /api/workspaces/<slug>/radar/runtime/v1/.
RADAR_COMMAND_URL=
RADAR_COMMAND_TOKEN=
RADAR_VAULT_PATH=/data/radar-vault
RADAR_CONTEXT=company:radar-pilot
RADAR_PERSON_ID=
# Comma-separated exact versions accepted at startup. An empty allowlist or a
# version outside it leaves the integration degraded and unavailable.
RADAR_ALLOWED_TBOX_VERSIONS=3.2.0
# Phase 4 keeps writes behind an independent flag.  With false, RADAR remains
# query-only even when the integration itself is healthy.  The operation list
# is a host allowlist, never a model argument. Manager contexts are needed only
# when delegating an action that the authenticated RADAR person does not own.
RADAR_WRITES_ENABLED=false
RADAR_WRITE_OPERATIONS=capture_issue,delegate,review,record_measurement
RADAR_INTENT_DEDUP_WINDOW_SECONDS=86400
RADAR_MANAGER_CONTEXTS=
RADAR_APPROVAL_TTL_SECONDS=900
# Read only by docker-compose.prod.yml. The vault is kept live on the VPS host
# by Obsidian Headless Sync (docs/plans/radar-obsidian-vault-separation.md)
# running as this uid/gid; the container is started with the same uid/gid so
# it can read the synced files.
RADAR_VAULT_HOST_PATH=
RADAR_VAULT_UID=
RADAR_VAULT_GID=
# Build-only credential for the private, commit-pinned radar-vault dependency.
# Export a fine-grained read-only token as GITHUB_TOKEN before `docker compose
# build`; BuildKit does not persist it in the image or pass it to the app.
GITHUB_TOKEN=

# Notion
# Optional integration, off by default. NOTION_ENABLED=true plus the token and
# the two data source ids below publish the five task/project tools, the MCP
# fallback and the task-agent subagent; with the flag off none of them reach
# the model, and no schema or data is affected either way.
#
# Since API version 2025-09-03 the queryable object is a data source, not the
# database that contains it. Run `python scripts/notion_schema.py` to confirm
# the ids. The legacy names NOTION_TASK_DATABASE_ID / NOTION_PROJECT_DATABASE_ID
# are still accepted.
NOTION_ENABLED=false
NOTION_TOKEN=
NOTION_TASK_DATA_SOURCE_ID=
NOTION_PROJECT_DATA_SOURCE_ID=

# People directory: the data source the task board's "PESSOAS" relation points
# at. Optional — without it the assistant reads and writes every other column
# and simply reports no people on a task. `python scripts/notion_schema.py`
# prints the relation target of "PESSOAS", which is the id to paste here.
NOTION_PEOPLE_DATA_SOURCE_ID=

# Reference library (ADR-013), where `save_reference` files the links you send.
# Optional: leave it empty and the assistant simply cannot save references —
# the tool is not offered to the model at all, rather than failing when used.
# Unlike the two above, this data source does not exist yet in a fresh install.
# Create a Notion database with exactly these columns and share it with the
# integration, then put its data source id here:
#
#   Nome      title          the reference's title
#   URL       url            the address
#   Tipo      select         Artigo, Vídeo, Post, Documentação, Ferramenta,
#                            Livro, Podcast, Outro
#   Tags      multi_select   free; new options are created on first use
#   Fonte     text           site or publication
#   Autor     text           who wrote it
#   Resumo    text           two or three sentences on what it is about
#   Salvo em  date           filled in automatically
NOTION_REFERENCE_DATA_SOURCE_ID=

# Google OAuth (M4/M5)
# Calendar and Gmail share the desktop OAuth client but use separate grants and
# refresh tokens. Generate one token at a time with:
#   python scripts/google_oauth.py calendar
#   python scripts/google_oauth.py gmail
# The script opens Google's consent page, uses loopback + state + PKCE, prints
# the refresh token once and never edits this file or the database. Keep the
# consent screen in Production; a grant from a Testing screen may expire after
# seven days. Enabling an integration without every required value keeps its
# tools unpublished. Gmail can read and create plaintext drafts, never send.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_REFRESH_TOKEN=
GMAIL_ENABLED=false
GOOGLE_GMAIL_REFRESH_TOKEN=

# Model
# The agent resolves its chat model from AGENT_MODEL, written as
# "provider:model" (anthropic:claude-opus-5, openai:gpt-5.5, ...). The provider
# reads its own credential from the environment, so set the matching key below.
# If AGENT_MODEL is empty, OPENAI_MODEL is read as "openai:<model>"; if both are
# empty, the default is anthropic:claude-opus-5.
# Run `python scripts/test_agent.py --dry-run` to see which one was resolved.
AGENT_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db_chiefofstaff
POSTGRES_USER=personal_agent
# Required by Docker Compose. Choose a unique value; there is no default password.
POSTGRES_PASSWORD=
# Loopback host port used to publish the container's PostgreSQL for local
# diagnostics. Change it when 5432 is already taken on the host.
POSTGRES_EXPOSED_PORT=5432
# Optional full SQLAlchemy URL. When set, it takes precedence over the fields above.
DATABASE_URL=

# Scheduled jobs
# The dispatcher runs inside the API process and polls PostgreSQL for jobs
# whose time has come. Turn it off on a second replica so two dispatchers do
# not compete for the same slots, and in any container that must never deliver
# a real notification.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# Separate server-to-server key for Plane product runs (at least 32 ASCII chars).
# Unset keeps /agent-runtime/v1 unavailable. Do not reuse RADAR_API_KEY.
RADAR_AGENT_RUNTIME_TOKEN=
